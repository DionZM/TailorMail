<Application x:Class="TailorMail.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:TailorMail.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="DisplayFontFamily">Georgia, Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="BodyFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="UIFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas</FontFamily>

            <Color x:Key="AccentColor">#1D6FB5</Color>
            <Color x:Key="AccentHoverColor">#185A94</Color>
            <Color x:Key="AccentLightColor">#E0F0FF</Color>
            <Color x:Key="AccentMidColor">#4DA6E8</Color>
            <Color x:Key="SurfaceColor">#F2F5F9</Color>
            <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#DDE2E9</Color>
            <Color x:Key="SkeletonColor">#E8ECF0</Color>
            <Color x:Key="TextPrimaryColor">#1A2332</Color>
            <Color x:Key="TextSecondaryColor">#5A6A7E</Color>
            <Color x:Key="TextTertiaryColor">#626F82</Color>
            <Color x:Key="SuccessColor">#047857</Color>
            <Color x:Key="WarningColor">#A16207</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="InfoColor">#2563EB</Color>
            <Color x:Key="RowHoverColor">#EDF2F8</Color>
            <Color x:Key="RowSelectedColor">#D6E9FB</Color>

            <Color x:Key="OnAccentColor">#FFFFFF</Color>
            <Color x:Key="OnAccentLightColor">#1D6FB5</Color>
            <Color x:Key="AccentDisabledColor">#B0C4D8</Color>

            <Color x:Key="SurfaceVariantColor">#E8ECF0</Color>
            <Color x:Key="OutlineColor">#C0C8D4</Color>
            <Color x:Key="OutlineLightColor">#E0E4EA</Color>

            <Color x:Key="SuccessLightColor">#ECFDF5</Color>
            <Color x:Key="DangerLightColor">#FEF2F2</Color>
            <Color x:Key="WarningLightColor">#FFFBEB</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}"/>

            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
            <SolidColorBrush x:Key="OnAccentLightBrush" Color="{StaticResource OnAccentLightColor}"/>
            <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}"/>

            <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
            <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
            <SolidColorBrush x:Key="OutlineLightBrush" Color="{StaticResource OutlineLightColor}"/>

            <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
            <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>
            <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}"/>

            <sys:Double x:Key="SpacingXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
            <sys:Double x:Key="SpacingSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
            <sys:Double x:Key="SpacingM2" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
            <sys:Double x:Key="SpacingMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
            <sys:Double x:Key="SpacingLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
            <sys:Double x:Key="SpacingXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
            <sys:Double x:Key="Spacing2XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">48</sys:Double>
            <sys:Double x:Key="Spacing3XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">64</sys:Double>
            <sys:Double x:Key="Spacing4XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">96</sys:Double>

            <sys:Double x:Key="FontSizeXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
            <sys:Double x:Key="FontSizeSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
            <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
            <sys:Double x:Key="FontSizeMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
            <sys:Double x:Key="FontSizeLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">25</sys:Double>
            <sys:Double x:Key="FontSizeXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">31</sys:Double>
            <sys:Double x:Key="FontSize2XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">39</sys:Double>
            <sys:Double x:Key="FontSize3XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">49</sys:Double>

            <CornerRadius x:Key="CornerRadiusXS">2</CornerRadius>
            <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
            <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
            <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>
            <CornerRadius x:Key="CornerRadiusInput">6</CornerRadius>

            <Thickness x:Key="PaddingDialogContent">24</Thickness>
            <Thickness x:Key="PaddingListItem">12,8</Thickness>
            <Thickness x:Key="PaddingTableCell">8,6</Thickness>

            <DropShadowEffect x:Key="ShadowSM" x:Shared="False" BlurRadius="4" ShadowDepth="1" Opacity="0.06" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowMD" x:Shared="False" BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowLG" x:Shared="False" BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowFloating" x:Shared="False" BlurRadius="30" ShadowDepth="6" Opacity="0.18" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowAccent" x:Shared="False" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="{StaticResource AccentColor}" Direction="270"/>

            <sys:Double x:Key="DurationFast" xmlns:sys="clr-namespace:System;assembly=mscorlib">150</sys:Double>
            <sys:Double x:Key="DurationNormal" xmlns:sys="clr-namespace:System;assembly=mscorlib">300</sys:Double>
            <sys:Double x:Key="DurationSlow" xmlns:sys="clr-namespace:System;assembly=mscorlib">500</sys:Double>
            <sys:Double x:Key="LineHeightDefault" xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>

            <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
            <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn"/>
            <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>

            <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="{StaticResource LineHeightDefault}"/>
            </Style>

            <Style TargetType="Border" x:Key="SectionTitleAccentStyle">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Width" Value="3"/>
                <Setter Property="CornerRadius" Value="1.5"/>
                <Setter Property="Margin" Value="0,2,8,2"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="CaptionTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="LineHeight" Value="{StaticResource LineHeightDefault}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                <Setter Property="LineHeight" Value="{StaticResource LineHeightDefault}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="WrappingCellStyle">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxHeight" Value="52"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="DataGridWrappingCellStyle">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxHeight" Value="52"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="20,16,20,24"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect" Value="{StaticResource ShadowMD}"/>
            </Style>

            <Style TargetType="Border" x:Key="CardStyleDense" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <Style TargetType="Button" x:Key="IconButtonStyle">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusSM}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceVariantBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource OutlineLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="SmallButtonStyle">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusSM}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceVariantBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource OutlineLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="StandardButtonStyle">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Height" Value="32"/>
            </Style>

            <Style TargetType="ToggleButton" x:Key="IconToggleButtonStyle">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusSM}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceVariantBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource OutlineLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#C8DFF5"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox" x:Key="ToolbarComboBoxStyle">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource OutlineLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
            </Style>

            <Style TargetType="TextBox" x:Key="ToolbarTextBoxStyle">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="DataGridRow" x:Key="HoverRowStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Border" x:Key="ColorPickerPopupStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect" Value="{StaticResource ShadowFloating}"/>
            </Style>

            <Style TargetType="Rectangle" x:Key="ColorSwatchStyle">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="RadiusX" Value="4"/>
                <Setter Property="RadiusY" Value="4"/>
            </Style>

            <Style TargetType="Button" x:Key="DeleteRowButtonStyle">
                <Setter Property="Content" Value="×"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadiusSM}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                    <Setter Property="Foreground" Value="#A02018"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Border" x:Key="EmptyStateStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="24,32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="ErrorStateStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="24,32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ui:SymbolIcon" x:Key="EmptyStateIconStyle">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="EmptyStateTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="SkeletonLineStyle">
                <Setter Property="Background" Value="{StaticResource SkeletonBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}"/>
                <Setter Property="Height" Value="14"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="TabularNumberStyle">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <Style TargetType="Border" x:Key="DropZoneHighlightStyle">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="BodyTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="{StaticResource LineHeightDefault}"/>
            </Style>

            <!-- Shared sidebar list item style (RecipientsPage groups, PreviewPage recipients, AttachmentPage common files) -->
            <Style TargetType="ListBoxItem" x:Key="SidebarListItemStyle">
                <Setter Property="Padding" Value="{StaticResource PaddingListItem}"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{StaticResource CornerRadiusSM}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared toolbar card style (reduced padding for action bars) -->
            <Style TargetType="Border" x:Key="ToolbarCardStyle" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- 20.2 Unified input styles -->
            <Style TargetType="TextBox" x:Key="UnifiedTextBoxStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CornerRadiusInput}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentMidBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox" x:Key="UnifiedComboBoxStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            </Style>

            <!-- 20.4 Divider styles -->
            <Style TargetType="Border" x:Key="DividerStyle">
                <Setter Property="Background" Value="{StaticResource OutlineLightBrush}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="0,8"/>
            </Style>

            <Style TargetType="Border" x:Key="VerticalDividerStyle">
                <Setter Property="Background" Value="{StaticResource OutlineLightBrush}"/>
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>

            <!-- 20.5 Fluent thin scrollbar -->
            <Style TargetType="ScrollBar" x:Key="FluentScrollBarStyle">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border x:Name="TrackBackground" Background="Transparent" CornerRadius="4"/>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBd"
                                                            Background="{StaticResource OutlineBrush}"
                                                            CornerRadius="4"
                                                            Opacity="0.4"
                                                            Margin="1"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Opacity" Value="0.7"/>
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBd" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
            <converters:IntToVisibleConverter x:Key="IntToVisibleConverter"/>
            <converters:FileNameConverter x:Key="FileNameConverter"/>
            <converters:FileSizeConverter x:Key="FileSizeConverter"/>
            <converters:FilePathSizeConverter x:Key="FilePathSizeConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:FailedToVisibilityConverter x:Key="FailedToVisibilityConverter"/>
            <converters:FileTypeToIconConverter x:Key="FileTypeToIconConverter"/>

            <!-- 12.5 Filter Tab style for SendPage -->
            <Style TargetType="RadioButton" x:Key="FilterTabStyle">
                <Setter Property="GroupName" Value="SendFilter"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="TabBd" Background="Transparent"
                                    CornerRadius="{StaticResource CornerRadiusSM}"
                                    Padding="10,4" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TabBd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBd" Property="Background" Value="{StaticResource SurfaceVariantBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
