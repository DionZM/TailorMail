<Application x:Class="TailorMail.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:TailorMail.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="DisplayFontFamily">Georgia, Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="BodyFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="UIFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas</FontFamily>

            <Color x:Key="AccentColor">#1D6FB5</Color>
            <Color x:Key="AccentHoverColor">#185A94</Color>
            <Color x:Key="AccentLightColor">#E0F0FF</Color>
            <Color x:Key="AccentMidColor">#4DA6E8</Color>
            <Color x:Key="SurfaceColor">#F2F5F9</Color>
            <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#DDE2E9</Color>
            <Color x:Key="SkeletonColor">#E8ECF0</Color>
            <Color x:Key="TextPrimaryColor">#1A2332</Color>
            <Color x:Key="TextSecondaryColor">#5A6A7E</Color>
            <Color x:Key="TextTertiaryColor">#626F82</Color>
            <Color x:Key="SuccessColor">#047857</Color>
            <Color x:Key="WarningColor">#A16207</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="RowHoverColor">#EDF2F8</Color>
            <Color x:Key="RowSelectedColor">#D6E9FB</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
            <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
            <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}"/>

            <sys:Double x:Key="SpacingXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>
            <sys:Double x:Key="SpacingSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">8</sys:Double>
            <sys:Double x:Key="SpacingMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
            <sys:Double x:Key="SpacingLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
            <sys:Double x:Key="SpacingXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
            <sys:Double x:Key="Spacing2XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">48</sys:Double>
            <sys:Double x:Key="Spacing3XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">64</sys:Double>
            <sys:Double x:Key="Spacing4XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">96</sys:Double>

            <sys:Double x:Key="FontSizeXS" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
            <sys:Double x:Key="FontSizeSM" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
            <sys:Double x:Key="FontSizeBase" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
            <sys:Double x:Key="FontSizeMD" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
            <sys:Double x:Key="FontSizeLG" xmlns:sys="clr-namespace:System;assembly=mscorlib">25</sys:Double>
            <sys:Double x:Key="FontSizeXL" xmlns:sys="clr-namespace:System;assembly=mscorlib">31</sys:Double>
            <sys:Double x:Key="FontSize2XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">39</sys:Double>
            <sys:Double x:Key="FontSize3XL" xmlns:sys="clr-namespace:System;assembly=mscorlib">49</sys:Double>

            <CornerRadius x:Key="CornerRadiusXS">2</CornerRadius>
            <CornerRadius x:Key="CornerRadiusSM">4</CornerRadius>
            <CornerRadius x:Key="CornerRadiusMD">8</CornerRadius>
            <CornerRadius x:Key="CornerRadiusLG">12</CornerRadius>
            <CornerRadius x:Key="CornerRadiusXL">16</CornerRadius>

            <DropShadowEffect x:Key="ShadowSM" x:Shared="False" BlurRadius="4" ShadowDepth="1" Opacity="0.06" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowMD" x:Shared="False" BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowLG" x:Shared="False" BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="{StaticResource TextPrimaryColor}" Direction="270"/>
            <DropShadowEffect x:Key="ShadowAccent" x:Shared="False" BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="{StaticResource AccentColor}" Direction="270"/>

            <sys:Double x:Key="DurationFast" xmlns:sys="clr-namespace:System;assembly=mscorlib">150</sys:Double>
            <sys:Double x:Key="DurationNormal" xmlns:sys="clr-namespace:System;assembly=mscorlib">300</sys:Double>
            <sys:Double x:Key="DurationSlow" xmlns:sys="clr-namespace:System;assembly=mscorlib">500</sys:Double>

            <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
            <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn"/>
            <CubicEase x:Key="EaseInOutCubic" EasingMode="EaseInOut"/>

            <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeMD}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="Border" x:Key="SectionTitleAccentStyle">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Width" Value="3"/>
                <Setter Property="CornerRadius" Value="1.5"/>
                <Setter Property="Margin" Value="0,2,8,2"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="CaptionTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeSM}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="WrappingCellStyle">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="MaxHeight" Value="52"/>
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="DataGridWrappingCellStyle">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxHeight" Value="52"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="20,16,20,24"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect" Value="{StaticResource ShadowMD}"/>
            </Style>

            <Style TargetType="DataGridRow" x:Key="HoverRowStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Border" x:Key="ColorPickerPopupStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Effect" Value="{StaticResource ShadowLG}"/>
            </Style>

            <Style TargetType="Rectangle" x:Key="ColorSwatchStyle">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="RadiusX" Value="4"/>
                <Setter Property="RadiusY" Value="4"/>
            </Style>

            <Style TargetType="Button" x:Key="DeleteRowButtonStyle">
                <Setter Property="Content" Value="×"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1AC42B1C"/>
                        <Setter Property="Foreground" Value="#A02018"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Border" x:Key="EmptyStateStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="24,32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="ErrorStateStyle">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Padding" Value="24,32"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="ui:SymbolIcon" x:Key="EmptyStateIconStyle">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="EmptyStateTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border" x:Key="SkeletonLineStyle">
                <Setter Property="Background" Value="{StaticResource SkeletonBrush}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSM}"/>
                <Setter Property="Height" Value="14"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="TabularNumberStyle">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            </Style>

            <Style TargetType="Border" x:Key="DropZoneHighlightStyle">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusLG}"/>
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="BodyTextStyle">
                <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="LineHeight" Value="24"/>
            </Style>

            <!-- Shared sidebar list item style (RecipientsPage groups, PreviewPage recipients, AttachmentPage common files) -->
            <Style TargetType="ListBoxItem" x:Key="SidebarListItemStyle">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{StaticResource CornerRadiusSM}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared toolbar card style (reduced padding for action bars) -->
            <Style TargetType="Border" x:Key="ToolbarCardStyle" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
            <converters:IntToVisibleConverter x:Key="IntToVisibleConverter"/>
            <converters:FileNameConverter x:Key="FileNameConverter"/>
            <converters:FileSizeConverter x:Key="FileSizeConverter"/>
            <converters:FilePathSizeConverter x:Key="FilePathSizeConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:FailedToVisibilityConverter x:Key="FailedToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
