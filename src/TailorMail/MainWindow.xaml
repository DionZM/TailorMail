<ui:FluentWindow x:Class="TailorMail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="千函 - TailorMail" Height="680" Width="1024"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{StaticResource SurfaceBrush}">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title=""
                     HorizontalAlignment="Stretch"
                     ShowMaximize="True" ShowMinimize="True" ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/logo_256.png" Width="20" Height="20"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.CenterContent>
                <Grid HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="千函" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Border x:Name="PillStepper" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="20" Padding="4" Margin="0,2,0,0">
                    <ItemsControl x:Name="StepItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnStepClick" Tag="{Binding Index}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0" Cursor="Hand">
                                    <Border CornerRadius="16" Padding="14,6" MinWidth="90">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Current">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Effect" Value="{StaticResource ShadowAccent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                        <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Visited">
                                                        <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Setter Property="Text" Value="{Binding DisplayIndex}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Current">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="Text" Value="✓"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Setter Property="Text" Value="{Binding Label}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Current">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Visited">
                                                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <Border Grid.Row="1" x:Name="AccentBar" Height="3" Margin="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource AccentMidColor}" Offset="0.3"/>
                    <GradientStop Color="Transparent" Offset="0.6"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ContentControl Grid.Row="2" x:Name="MainContent" Margin="32,8,32,16"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="MainContentTransform" Y="0"/>
            </ContentControl.RenderTransform>
        </ContentControl>

        <Grid Grid.Row="2" x:Name="SkeletonHost" Margin="32,8,32,16" Visibility="Collapsed">
            <!-- Step 0: Recipients (sidebar + table) -->
            <StackPanel x:Name="SkeletonStep0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="0">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="80" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="140" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="120" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="100"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="1">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="180" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="500" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="450" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="380"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- Step 1: Variables (toolbar + table) -->
            <StackPanel x:Name="SkeletonStep1" Visibility="Collapsed">
                <Border Style="{StaticResource ToolbarCardStyle}" Margin="0">
                    <StackPanel Margin="4" Orientation="Horizontal">
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="80" Height="24" Margin="0,0,8,0"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="60" Height="24"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="140" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="500" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="420" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Step 3: Attachments (sidebar + table) -->
            <StackPanel x:Name="SkeletonStep3" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="0">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="80" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="150" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="130"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="1">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="80" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="500" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="460" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="300"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- Step 4: Preview (sidebar + content) -->
            <StackPanel x:Name="SkeletonStep4" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="0">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="120" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="160" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="140" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="100"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Grid.Column="1">
                        <StackPanel Margin="4">
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="200" Margin="0,0,0,12"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="500" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="440" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SkeletonLineStyle}" Width="380"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- Generic fallback (steps 2, 5) -->
            <StackPanel x:Name="SkeletonGeneric" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="180" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="100" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="320" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="240"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="140" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="400" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource SkeletonLineStyle}" Width="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="24,10,24,12"
                Effect="{StaticResource ShadowSM}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStepHint" Text="步骤 1/6 · 收件选择"
                               Style="{StaticResource CaptionTextStyle}"/>
                    <TextBlock Text=" — " Foreground="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStepDesc"
                               Style="{StaticResource CaptionTextStyle}"/>
                    <TextBlock Text=" — " Foreground="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtShortcutHint"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnPrev" Content="上一步" Padding="16,6" Margin="0,0,8,0"
                               Click="BtnPrev_Click" Appearance="Secondary"
                               AutomationProperties.Name="上一步"
                               AutomationProperties.HelpText="返回上一个步骤"
                               ToolTip="上一步"/>
                    <ui:Button x:Name="BtnSend" Content="开始发送" Padding="20,6" Margin="0,0,8,0"
                               Click="BtnSend_Click" Appearance="Primary"
                               AutomationProperties.Name="开始发送"
                               AutomationProperties.HelpText="开始批量发送邮件"
                               ToolTip="开始发送邮件"
                               Visibility="Collapsed"/>
                    <ui:Button x:Name="BtnStop" Content="停止发送" Padding="20,6" Margin="0,0,8,0"
                               Click="BtnStop_Click" Appearance="Danger"
                               AutomationProperties.Name="停止发送"
                               AutomationProperties.HelpText="停止正在进行的发送"
                               ToolTip="停止正在进行的发送"
                               Visibility="Collapsed"/>
                    <ui:Button x:Name="BtnNext" Content="下一步" Padding="20,6" Click="BtnNext_Click"
                               AutomationProperties.Name="下一步"
                               AutomationProperties.HelpText="前进到下一个步骤"
                               ToolTip="下一步"/>
                    <ui:DropDownButton x:Name="BtnMenu" Padding="8,6" Margin="8,0,0,0"
                                       Appearance="Secondary" ToolTip="更多操作">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="MoreVertical24"/>
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="新建邮件 (Ctrl+N)" Click="BtnNewMail_Click"/>
                                <Separator/>
                                <MenuItem Header="设置" Click="BtnSettings_Click"/>
                                <MenuItem Header="关于 (F1)" Click="BtnAbout_Click"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="0,0,0,20">
        </ui:SnackbarPresenter>
    </Grid>
</ui:FluentWindow>
