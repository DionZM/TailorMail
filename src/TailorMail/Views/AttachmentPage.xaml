<UserControl x:Class="TailorMail.Views.AttachmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CommonPanelColumn" Width="220" MinWidth="180" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Border Style="{StaticResource CardStyle}" Margin="0" AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="公共附件" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Click="OnAddCommon" Margin="8,0,0,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,2,0"/>
                                <TextBlock Text="添加"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearCommon" Margin="4,0,0,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,2,0"/>
                                <TextBlock Text="清空"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="1" AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop">
                        <ListBox x:Name="CommonList" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource UIFontFamily}" MinHeight="60"
                                 AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource BodyTextStyle}" MaxWidth="260"/>
                                            <TextBlock Text="{Binding Converter={StaticResource FilePathSizeConverter}}" Margin="6,0,0,0"
                                                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="OnRemoveCommon" Tag="{Binding}"
                                                Style="{StaticResource DeleteRowButtonStyle}"
                                                ToolTip="删除此附件"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="CommonEmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
                                AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Document24" Style="{StaticResource EmptyStateIconStyle}"/>
                                <TextBlock Text="暂无公共附件" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="点击下方按钮或拖拽文件到此处" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Button Click="OnAddCommon" Padding="16,6" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0" Foreground="White"/>
                                        <TextBlock Text="添加公共附件"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="DragHintText" Grid.Row="2" Text="拖拽文件到此处也可添加"
                               Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      Cursor="SizeWE"/>

        <Grid Grid.Row="0" Grid.Column="2">
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="专有附件" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Click="OnSelectDirectory" Margin="12,0,0,0" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="选择文件夹"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAutoMatch" Click="OnAutoMatch" Margin="4,0,0,0" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="自动匹配"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnClearSpecial" Margin="4,0,0,0" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="清空"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="TxtFolder" Text="" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" MaxWidth="350"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtMatchResult" Text="" VerticalAlignment="Center"
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"
                                       Style="{StaticResource CaptionTextStyle}" Margin="8,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="自动匹配规则：按收件人「名称」或「简称」匹配文件名（不含扩展名）"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RecipientGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" BorderThickness="0" Background="Transparent"
                                  FontFamily="{StaticResource UIFontFamily}" FontSize="13"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  AllowDrop="True" DragOver="OnRecipientDragOver" Drop="OnRecipientDrop"
                                  RowStyle="{StaticResource HoverRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="发送对象" Binding="{Binding RecipientName}" Width="120" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="专有附件" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding Files}" Margin="0,2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource SuccessBrush}" FontSize="12"
                                                                           VerticalAlignment="Center" MaxWidth="300"
                                                                           ToolTip="{Binding}"/>
                                                                <TextBlock Text="{Binding Converter={StaticResource FilePathSizeConverter}}" FontSize="11"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <Button Click="OnRemoveSpecialFromGrid" Tag="{Binding}"
                                                                        Style="{StaticResource DeleteRowButtonStyle}"
                                                                        FontSize="12" Margin="4,0,0,0"
                                                                        ToolTip="删除此附件"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="暂无专有附件" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="OnAddRecipientAttachmentFromGrid" Tag="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Padding="4,4"
                                                    ToolTip="添加专有附件">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="14"/>
                                                    <TextBlock Text="添加" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="SpecialEmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Folder24" Style="{StaticResource EmptyStateIconStyle}"/>
                                <TextBlock Text="暂无专有附件" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择文件夹后点击「自动匹配」" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Button Click="OnSelectDirectory" Padding="16,6" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0" Foreground="White"/>
                                        <TextBlock Text="选择文件夹"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
