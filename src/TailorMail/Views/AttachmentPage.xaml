<UserControl x:Class="TailorMail.Views.AttachmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CommonPanelColumn" Width="220" MinWidth="180" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Border Style="{StaticResource CardStyle}" Margin="0" AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop" DragEnter="OnDragEnter" DragLeave="OnDragLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 + 添加按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="公共附件" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ui:Button Click="OnAddCommon" Padding="6,4" HorizontalAlignment="Right" ToolTip="添加公共附件">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14"/>
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="1" AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop">
                        <ListBox x:Name="CommonList" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource UIFontFamily}" MinHeight="60"
                                 AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop"
                                 MouseLeftButtonUp="OnCommonListClick"
                                 ItemContainerStyle="{StaticResource SidebarListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="{Binding Converter={StaticResource FileTypeToIconConverter}}"/>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource FileNameConverter}}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource FilePathSizeConverter}}"
                                                   FontSize="{StaticResource FontSizeXS}" Opacity="0.7"
                                                   VerticalAlignment="Center" Margin="6,0,6,0" HorizontalAlignment="Right"/>
                                        <Button Grid.Column="3" Click="OnRemoveCommon" Tag="{Binding}"
                                                Style="{StaticResource DeleteRowButtonStyle}"
                                                ToolTip="删除此附件"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="CommonEmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed"
                                AllowDrop="True" DragOver="OnDragOver" Drop="OnCommonDrop">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Document24" Style="{StaticResource EmptyStateIconStyle}"/>
                                <TextBlock Text="暂无公共附件" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="点击下方按钮或拖拽文件到此处" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:Button Click="OnAddCommon" Padding="16,6" HorizontalAlignment="Center" Appearance="Primary">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                                        <TextBlock Text="添加公共附件"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 清空公共附件按钮 -->
                    <ui:Button Grid.Row="2" Click="OnClearCommon" Padding="6,4" Margin="0,8,0,0"
                            HorizontalAlignment="Right" ToolTip="清空公共附件">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14"/>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      Cursor="SizeWE"/>

        <Grid Grid.Row="0" Grid.Column="2">
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="专有附件" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFolder" Grid.Row="0" Grid.Column="1" Text="" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="8,0,8,0"/>
                        <ui:Button Grid.Row="0" Grid.Column="2" Click="OnSelectDirectory" Style="{StaticResource SmallButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="选择文件夹" FontSize="{StaticResource FontSizeSM}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Row="0" Grid.Column="3" x:Name="BtnAutoMatch" Click="OnAutoMatch" Margin="4,0,0,0" Style="{StaticResource SmallButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Link24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="自动匹配" FontSize="{StaticResource FontSizeSM}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Row="0" Grid.Column="4" Click="OnClearSpecial" Margin="4,0,0,0" Style="{StaticResource SmallButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="清空" FontSize="{StaticResource FontSizeSM}"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:InfoBar x:Name="MatchInfoBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                    Title="" Message="" IsOpen="False" IsClosable="True"
                                    Severity="Informational" Margin="0,4,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RecipientGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" BorderThickness="0" Background="Transparent"
                                  FontFamily="{StaticResource UIFontFamily}" FontSize="13"
                                  GridLinesVisibility="Horizontal" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  AllowDrop="True" DragOver="OnRecipientDragOver" Drop="OnRecipientDrop"
                                  RowStyle="{StaticResource HoverRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="发送对象" Binding="{Binding RecipientName}" Width="120" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="专有附件" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding Files}" Margin="0,2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource SuccessBrush}" FontSize="{StaticResource FontSizeSM}"
                                                                           VerticalAlignment="Center" MaxWidth="300"
                                                                           ToolTip="{Binding}"/>
                                                                <TextBlock Text="{Binding Converter={StaticResource FilePathSizeConverter}}" FontSize="{StaticResource FontSizeXS}"
                                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <Button Click="OnRemoveSpecialFromGrid" Tag="{Binding}"
                                                                        Style="{StaticResource DeleteRowButtonStyle}"
                                                                        FontSize="{StaticResource FontSizeSM}" Margin="4,0,0,0"
                                                                        ToolTip="删除此附件"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="暂无专有附件" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="OnAddRecipientAttachmentFromGrid" Tag="{Binding}"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    ToolTip="添加专有附件">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="14"/>
                                                    <TextBlock Text="添加" FontSize="{StaticResource FontSizeXS}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="SpecialEmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Folder24" Style="{StaticResource EmptyStateIconStyle}"/>
                                <TextBlock Text="暂无专有附件" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="选择文件夹后点击「自动匹配」" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:Button Click="OnSelectDirectory" Padding="16,6" HorizontalAlignment="Center" Appearance="Primary">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,4,0"/>
                                        <TextBlock Text="选择文件夹"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="自动匹配规则：按收件人「名称」或「简称」匹配文件名（不含扩展名）"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
