<UserControl x:Class="TailorMail.Views.MailComposePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16,8">
            <ui:TextBox x:Name="SubjectBox" Text="{Binding Subject,UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="请输入邮件主题，支持 {变量名} 格式" FontSize="14"
                        FontFamily="{StaticResource UIFontFamily}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox x:Name="VariableCombo" Width="160" Margin="0,0,8,0" Padding="8,6"/>
                        <Button Click="OnInsertVariable" Margin="0,0,8,0" Padding="8,4" ToolTip="插入变量到光标位置">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="插入变量"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="4,2"/>
                        <ToggleButton x:Name="BoldBtn" Click="OnToggleBold" ToolTip="粗体 (Ctrl+B)" Margin="8,0,0,0" Width="36" Height="28" FontSize="13">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicBtn" Click="OnToggleItalic" ToolTip="斜体 (Ctrl+I)" Margin="4,0,0,0" Width="36" Height="28" FontSize="13">
                            <TextBlock Text="I" FontStyle="Italic"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineBtn" Click="OnToggleUnderline" ToolTip="下划线 (Ctrl+U)" Margin="4,0,0,0" Width="36" Height="28" FontSize="13">
                            <TextBlock TextDecorations="Underline" Text="U"/>
                        </ToggleButton>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="8,2"/>
                        <Button x:Name="AlignLeftBtn" Click="OnAlignLeft" ToolTip="左对齐" Margin="8,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="14"/>
                        </Button>
                        <Button x:Name="AlignCenterBtn" Click="OnAlignCenter" ToolTip="居中" Margin="4,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="TextAlignCenter24" FontSize="14"/>
                        </Button>
                        <Button x:Name="AlignRightBtn" Click="OnAlignRight" ToolTip="右对齐" Margin="4,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="TextAlignRight24" FontSize="14"/>
                        </Button>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="8,2"/>
                        <Button x:Name="UndoBtn" Click="OnUndo" ToolTip="撤销 (Ctrl+Z)" Margin="8,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14"/>
                        </Button>
                        <Button x:Name="RedoBtn" Click="OnRedo" ToolTip="重做 (Ctrl+Y)" Margin="4,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="14"/>
                        </Button>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="8,2"/>
                        <ComboBox x:Name="FontSizeCombo" Width="64" Margin="8,0,0,0" Padding="4,4"
                                  SelectionChanged="OnFontSizeComboChanged" IsEditable="True"
                                  KeyDown="OnFontSizeKeyDown" FontSize="12"
                                  PreviewTextInput="OnFontSizePreviewTextInput"/>
                        <TextBlock x:Name="FontSizeError" Text="" FontSize="10" Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="8,2"/>
                        <Border x:Name="ColorPreview" Width="22" Height="22" CornerRadius="4"
                                Background="Black" Margin="0,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                Cursor="Hand" MouseLeftButtonUp="OnColorPickerClick" ToolTip="文字颜色"/>
                        <Popup x:Name="ColorPopup" StaysOpen="False" Placement="Bottom">
                            <Border Style="{StaticResource ColorPickerPopupStyle}">
                                <StackPanel>
                                    <WrapPanel Width="220" Orientation="Horizontal">
                                        <Rectangle Fill="Black" MouseLeftButtonUp="OnColorSelected" Tag="Black" Style="{StaticResource ColorSwatchStyle}" ToolTip="黑色"/>
                                        <Rectangle Fill="#333333" MouseLeftButtonUp="OnColorSelected" Tag="#333333" Style="{StaticResource ColorSwatchStyle}" ToolTip="深灰"/>
                                        <Rectangle Fill="#666666" MouseLeftButtonUp="OnColorSelected" Tag="#666666" Style="{StaticResource ColorSwatchStyle}" ToolTip="灰色"/>
                                        <Rectangle Fill="#999999" MouseLeftButtonUp="OnColorSelected" Tag="#999999" Style="{StaticResource ColorSwatchStyle}" ToolTip="浅灰"/>
                                        <Rectangle Fill="#DC2626" MouseLeftButtonUp="OnColorSelected" Tag="#DC2626" Style="{StaticResource ColorSwatchStyle}" ToolTip="红色"/>
                                        <Rectangle Fill="#EA580C" MouseLeftButtonUp="OnColorSelected" Tag="#EA580C" Style="{StaticResource ColorSwatchStyle}" ToolTip="橙色"/>
                                        <Rectangle Fill="#D97706" MouseLeftButtonUp="OnColorSelected" Tag="#D97706" Style="{StaticResource ColorSwatchStyle}" ToolTip="琥珀"/>
                                        <Rectangle Fill="#059669" MouseLeftButtonUp="OnColorSelected" Tag="#059669" Style="{StaticResource ColorSwatchStyle}" ToolTip="翠绿"/>
                                        <Rectangle Fill="#2563EB" MouseLeftButtonUp="OnColorSelected" Tag="#2563EB" Style="{StaticResource ColorSwatchStyle}" ToolTip="蓝色"/>
                                        <Rectangle Fill="#7C3AED" MouseLeftButtonUp="OnColorSelected" Tag="#7C3AED" Style="{StaticResource ColorSwatchStyle}" ToolTip="紫色"/>
                                        <Rectangle Fill="#DB2777" MouseLeftButtonUp="OnColorSelected" Tag="#DB2777" Style="{StaticResource ColorSwatchStyle}" ToolTip="粉红"/>
                                        <Rectangle Fill="#0891B2" MouseLeftButtonUp="OnColorSelected" Tag="#0891B2" Style="{StaticResource ColorSwatchStyle}" ToolTip="青色"/>
                                        <Rectangle Fill="#4F46E5" MouseLeftButtonUp="OnColorSelected" Tag="#4F46E5" Style="{StaticResource ColorSwatchStyle}" ToolTip="靛蓝"/>
                                        <Rectangle Fill="#15803D" MouseLeftButtonUp="OnColorSelected" Tag="#15803D" Style="{StaticResource ColorSwatchStyle}" ToolTip="绿色"/>
                                    </WrapPanel>
                                    <WrapPanel x:Name="RecentColorsPanel" Width="220" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,4"/>
                                    <Border Background="{StaticResource BorderSubtleBrush}" Height="1" Margin="0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="自定义颜色" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                        <ui:TextBox x:Name="CustomColorInput" Width="100" PlaceholderText="#RRGGBB"
                                                    FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Padding="6,4"/>
                                        <Button Content="应用" Click="OnApplyCustomColor" Margin="4,0,0,0" Padding="8,4" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CustomColorError" Text="" FontSize="11" Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Border Background="{StaticResource BorderSubtleBrush}" Width="1" Margin="8,2"/>
                        <Button Click="OnInsertLink" ToolTip="插入链接" Margin="8,0,0,0" Padding="6,4" Width="32" Height="28">
                            <ui:SymbolIcon Symbol="Link24" FontSize="14"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,8,0,0">
                    <RichTextBox x:Name="Editor" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource UIFontFamily}" FontSize="16" Padding="12"
                                 BorderThickness="0" TextChanged="OnEditorTextChanged"
                                 SelectionChanged="OnEditorSelectionChanged"
                                 SpellCheck.IsEnabled="False" AcceptsTab="False"
                                 Background="Transparent">
                            <RichTextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="剪切" Command="ApplicationCommands.Cut"/>
                                    <MenuItem Header="复制" Command="ApplicationCommands.Copy"/>
                                    <MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/>
                                    <Separator/>
                                    <MenuItem Header="插入变量" Click="OnInsertVariable"/>
                                    <MenuItem Header="插入链接" Click="OnInsertLink"/>
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                </Border>

                <Popup x:Name="AutoCompletePopup" StaysOpen="False" Placement="Bottom"
                       PlacementTarget="{Binding ElementName=Editor}"
                       AllowsTransparency="True" IsOpen="False">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                            MaxHeight="200" MinWidth="160" Padding="4">
                        <ListBox x:Name="AutoCompleteList" BorderThickness="0" Background="Transparent"
                                 MaxHeight="180" FontSize="13"
                                 SelectionChanged="OnAutoCompleteSelectionChanged"/>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <TextBlock x:Name="VarHintText" Grid.Row="2"
                   Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/>
        <TextBlock x:Name="VarWarningText" Grid.Row="2" Visibility="Collapsed"
                   Foreground="{StaticResource WarningBrush}" FontWeight="Medium"
                   Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
