<UserControl x:Class="TailorMail.Views.PreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,0,0"
                Effect="{StaticResource ShadowSM}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <ui:TextBox x:Name="SearchBox" PlaceholderText="搜索名称或邮箱..." Margin="0,0,0,8"
                                TextChanged="OnSearchTextChanged" Icon="{ui:SymbolIcon Search24}"/>
                    <ListBox Grid.Row="1" x:Name="ListGroups" DisplayMemberPath="Name"
                             BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource UIFontFamily}"
                             SelectionChanged="OnGroupSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="BtnPrevRecipient" Click="BtnPrevRecipient_Click" Padding="8,4" ToolTip="上一个 (←)">
                        <ui:SymbolIcon Symbol="ChevronLeft24"/>
                    </Button>
                    <TextBlock x:Name="TxtRecipientCounter" Text="" VerticalAlignment="Center" Margin="8,0"
                               Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <Button x:Name="BtnNextRecipient" Click="BtnNextRecipient_Click" Padding="8,4" ToolTip="下一个 (→)">
                        <ui:SymbolIcon Symbol="ChevronRight24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0"
                Effect="{StaticResource ShadowLG}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="主题：" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PreviewSubject}" TextWrapping="Wrap" FontWeight="Medium"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="BtnSendTest" Content="发送测试邮件给自己" Click="BtnSendTest_Click"
                                Padding="12,4" FontSize="12" ToolTip="发送一封测试邮件到您的发件人邮箱，验证实际效果"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="收件人：" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PreviewTo}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding PreviewCc, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="抄送：" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PreviewCc}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding PreviewBcc, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="密送：" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PreviewBcc}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>

                <Border Grid.Row="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusMD}" ClipToBounds="True">
                    <FlowDocumentScrollViewer x:Name="PreviewViewer" Background="Transparent"
                                               VerticalScrollBarVisibility="Auto"
                                               IsToolBarVisible="False"/>
                </Border>

                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="附件：" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TxtAttachmentTotal" Text="" FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl x:Name="PanelAttachments"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
