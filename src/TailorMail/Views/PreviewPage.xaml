<UserControl x:Class="TailorMail.Views.PreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 标题 + 导航按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="收件对象" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnPrevRecipient" Click="BtnPrevRecipient_Click" Padding="6,4" ToolTip="上一个 (↑)">
                            <ui:SymbolIcon Symbol="ChevronUp24"/>
                        </ui:Button>
                        <TextBlock x:Name="TxtRecipientCounter" Text="" VerticalAlignment="Center" Margin="4,0"
                                   Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <ui:Button x:Name="BtnNextRecipient" Click="BtnNextRecipient_Click" Padding="6,4" ToolTip="下一个 (↓)">
                            <ui:SymbolIcon Symbol="ChevronDown24"/>
                        </ui:Button>
                    </StackPanel>
                </Grid>
                <ui:TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="搜索名称或邮箱..." Margin="0,0,0,8"
                            TextChanged="OnSearchTextChanged" Icon="{ui:SymbolIcon Search24}"/>
                <ListBox Grid.Row="2" x:Name="ListGroups" DisplayMemberPath="Name"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="{StaticResource UIFontFamily}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnGroupSelected"
                         ItemContainerStyle="{StaticResource SidebarListItemStyle}">
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      Cursor="SizeWE"/>

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="主题：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PreviewSubject}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="收件人：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PreviewTo}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding PreviewCc, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="抄送：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PreviewCc}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding PreviewBcc, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="密送：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding PreviewBcc}" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusMD}" ClipToBounds="True">
                    <FlowDocumentScrollViewer x:Name="PreviewViewer" Background="Transparent"
                                               VerticalScrollBarVisibility="Auto"
                                               IsToolBarVisible="False"/>
                </Border>

                <!-- UI-39: Zoom slider -->
                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="缩放：" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,8,0"/>
                        <Slider x:Name="ZoomSlider" Minimum="50" Maximum="200" Value="100"
                                Width="120" VerticalAlignment="Center" TickFrequency="25"
                                IsSnapToTickEnabled="True" ValueChanged="OnZoomChanged"/>
                        <TextBlock x:Name="TxtZoom" Text="100%" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="8,0,0,0"
                                   MinWidth="36"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="6" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="附件：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtAttachmentTotal" Text="" FontSize="{StaticResource FontSizeSM}"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl x:Name="PanelAttachments"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
