<ui:FluentWindow x:Class="TailorMail.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinWidth="480" MinHeight="520"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设置" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                       FontFamily="{StaticResource DisplayFontFamily}" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Border Style="{StaticResource SectionTitleAccentStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                            <TextBlock Text="发送通道" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbChannel" SelectedIndex="0" Padding="8,6" SelectionChanged="OnChannelChanged">
                            <ComboBoxItem Content="Outlook"/>
                            <ComboBoxItem Content="SMTP"/>
                        </ComboBox>
                        <StackPanel Margin="0,8,0,0">
                            <ui:InfoBar x:Name="OutlookAvailableBar"
                                        Title="Outlook 可用"
                                        Message="已检测到本机 Outlook，可直接使用。"
                                        IsOpen="True" IsClosable="False" Severity="Success"/>
                            <ui:InfoBar x:Name="OutlookUnavailableBar"
                                        Title="Outlook 不可用"
                                        Message="未检测到 Outlook，请使用 SMTP 方式发送。"
                                        IsOpen="False" IsClosable="False" Severity="Warning"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander x:Name="SmtpExpander" Header="SMTP 配置（点击展开）" IsExpanded="False" Padding="0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                                <TextBlock Text="SMTP 配置" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="常用邮箱：" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelTextStyle}"/>
                                <ComboBox x:Name="CmbPreset" Width="160" Padding="8,6" SelectionChanged="OnPresetChanged">
                                    <ComboBoxItem Content="（自定义）"/>
                                    <ComboBoxItem Content="QQ 邮箱"/>
                                    <ComboBoxItem Content="163 邮箱"/>
                                    <ComboBoxItem Content="Gmail"/>
                                    <ComboBoxItem Content="Outlook"/>
                                </ComboBox>
                            </StackPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="SMTP服务器" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServer" Margin="0,0,0,8"
                                            PlaceholderText="如：smtp.example.com"/>

                                <TextBlock Grid.Row="1" Text="端口" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="1" x:Name="TxtPort" Value="587" Minimum="1" Maximum="65535" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="启用SSL" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:ToggleSwitch x:Name="ChkSsl" IsChecked="True" Click="OnSslToggleChanged"/>
                                    <TextBlock x:Name="PortHintText" Text="" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="用户名" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtUsername" Margin="0,0,0,8"
                                            PlaceholderText="SMTP登录用户名"/>

                                <TextBlock Grid.Row="4" Text="密码" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="TxtPassword" Margin="0,0,0,8"
                                             Padding="8,6"/>

                                <TextBlock Grid.Row="5" Text="发件人名称" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtSenderName" Margin="0,0,0,8"
                                            PlaceholderText="收件人看到的发件人名称"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="发件人邮箱" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <ui:TextBox Grid.Column="1" x:Name="TxtSenderEmail" Margin="0,0,0,8"
                                            PlaceholderText="收件人看到的发件人地址"/>
                            </Grid>

                            <Border Background="{StaticResource AccentLightBrush}"
                                    CornerRadius="{StaticResource CornerRadiusSM}" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock Text="发件人邮箱可与登录用户名不同，部分SMTP服务器要求两者一致"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnTestConnection" Content="测试连接" Click="OnTestConnection"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <ui:ProgressRing x:Name="TestProgressRing" Width="20" Height="20" Visibility="Collapsed"/>
                            </StackPanel>
                            <ui:InfoBar x:Name="TestResultBar" Margin="0,8,0,0"
                                        IsOpen="False" IsClosable="False" Title="" Message=""/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                            <TextBlock Text="发送控制" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="发送间隔" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                            <ui:NumberBox Grid.Column="1" x:Name="TxtSendInterval" Value="1" Minimum="0" Maximum="60" SmallChange="0.1"/>
                            <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="设为0为不等待，建议 0.5-3 秒"
                                       Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                            <TextBlock Text="邮件签名" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Text="签名将自动追加到每封邮件正文末尾"
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
                        <ui:TextBox x:Name="TxtSignature" PlaceholderText="输入邮件签名（可留空）"
                                    AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="取消" Click="BtnCancel_Click" Padding="20,8" Margin="0,0,8,0" Appearance="Secondary"/>
            <ui:Button Content="保存配置" Click="BtnSave_Click" Padding="20,8" Appearance="Primary"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>