<ui:FluentWindow x:Class="TailorMail.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinWidth="580" MinHeight="540"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设置" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                       FontFamily="{StaticResource DisplayFontFamily}" Foreground="{StaticResource TextPrimaryBrush}"/>
            <Border Style="{StaticResource SectionTitleAccentStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140" MaxWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 14.1 Left navigation sidebar -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,0,0" Padding="8,8">
                <ListBox x:Name="SettingsNavList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnSettingsNavChanged"
                         SelectedIndex="0"
                         ItemContainerStyle="{StaticResource SidebarListItemStyle}">
                    <ListBoxItem Content="发送通道"/>
                    <ListBoxItem Content="发送参数"/>
                    <ListBoxItem Content="邮件签名"/>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Right content area -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ====== 发送通道 ====== -->
                    <Border x:Name="SectionChannel" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                                <TextBlock Text="发送通道" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbChannel" SelectedIndex="0" Padding="8,6" SelectionChanged="OnChannelChanged">
                                <ComboBoxItem Content="Outlook"/>
                                <ComboBoxItem Content="SMTP"/>
                            </ComboBox>
                            <StackPanel Margin="0,8,0,0">
                                <ui:InfoBar x:Name="OutlookAvailableBar"
                                            Title="Outlook 可用"
                                            Message="已检测到本机 Outlook，可直接使用。"
                                            IsOpen="True" IsClosable="False" Severity="Success"/>
                                <ui:InfoBar x:Name="OutlookUnavailableBar"
                                            Title="Outlook 不可用"
                                            Message="未检测到 Outlook，请使用 SMTP 方式发送。"
                                            IsOpen="False" IsClosable="False" Severity="Warning"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ====== SMTP 服务器 ====== -->
                    <Expander x:Name="SmtpExpander" Header="SMTP 服务器" IsExpanded="False" Padding="0" Margin="0,0,0,12">
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="常用邮箱：" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelTextStyle}"/>
                                    <ComboBox x:Name="CmbPreset" Width="160" Padding="8,6" SelectionChanged="OnPresetChanged">
                                        <ComboBoxItem Content="（自定义）"/>
                                        <ComboBoxItem Content="QQ 邮箱"/>
                                        <ComboBoxItem Content="163 邮箱"/>
                                        <ComboBoxItem Content="Gmail"/>
                                        <ComboBoxItem Content="Outlook"/>
                                    </ComboBox>
                                </StackPanel>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Text="SMTP服务器" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtServer" Margin="0,0,0,8"
                                                PlaceholderText="如：smtp.example.com"/>

                                    <TextBlock Grid.Row="1" Text="端口" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:NumberBox x:Name="TxtPort" Value="587" Minimum="1" Maximum="65535" Width="100"/>
                                        <ui:ToggleSwitch x:Name="ChkSsl" IsChecked="True" Content="SSL" Click="OnSslToggleChanged" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="PortHintText" Text="" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="用户名" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtUsername" Margin="0,0,0,8"
                                                PlaceholderText="SMTP登录用户名"/>

                                    <TextBlock Grid.Row="3" Text="密码" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="TxtPassword" Margin="0,0,0,8" Padding="8,6"/>
                                </Grid>

                                <Border Background="{StaticResource AccentLightBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSM}" Padding="12,8" Margin="0,0,0,12">
                                    <TextBlock Text="发件人邮箱可与登录用户名不同，部分 SMTP 服务器要求两者一致"
                                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Text="发件人名称" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtSenderName" Margin="0,0,0,8"
                                                PlaceholderText="收件人看到的发件人名称"/>
                                    <TextBlock Grid.Row="1" Text="发件人邮箱" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                    <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtSenderEmail" Margin="0,0,0,8"
                                                PlaceholderText="收件人看到的发件人地址"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button x:Name="BtnTestConnection" Content="测试连接" Click="OnTestConnection"
                                            Padding="12,6" Margin="0,0,8,0"/>
                                    <ui:ProgressRing x:Name="TestProgressRing" Width="20" Height="20" Visibility="Collapsed"/>
                                </StackPanel>
                                <ui:InfoBar x:Name="TestResultBar" Margin="0,8,0,0"
                                            IsOpen="False" IsClosable="False" Title="" Message=""/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <!-- ====== 发送参数 ====== -->
                    <Border x:Name="SectionSendParams" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                                <TextBlock Text="发送参数" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="发送间隔" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                <ui:NumberBox Grid.Column="1" x:Name="TxtSendInterval" Value="1" Minimum="0" Maximum="60" SmallChange="0.1"/>
                                <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="设为 0 不等待，建议 0.5-3 秒"
                                           Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Grid>

                            <Grid x:Name="SmtpConcurrencySection">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="并发数" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                <ui:NumberBox Grid.Column="1" x:Name="TxtSmtpConcurrency" Value="1" Minimum="1" Maximum="20"/>
                                <TextBlock Grid.Column="2" Text="连接" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="仅 SMTP 模式生效"
                                           Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Grid>

                            <Border x:Name="SmtpConcurrencyWarning" Background="#FFF8F0" CornerRadius="{StaticResource CornerRadiusSM}" Padding="12,8" Margin="0,8,0,0">
                                <TextBlock Text="并发数大于 1 时将同时建立多个 SMTP 连接，可加快发送速度，但部分邮件服务商可能会因短时间内大量发送而封禁账号。建议先以并发数 1 测试，确认无异常后再逐步提高。"
                                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ====== 邮件签名 ====== -->
                    <Border x:Name="SectionSignature" Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource SectionTitleAccentStyle}"/>
                                <TextBlock Text="邮件签名" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="签名将自动追加到每封邮件正文末尾"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8"/>
                            <ui:TextBox x:Name="TxtSignature" PlaceholderText="输入邮件签名（可留空）"
                                        AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="取消" Click="BtnCancel_Click" Padding="20,8" Margin="0,0,8,0" Appearance="Secondary"/>
            <ui:Button Content="保存配置" Click="BtnSave_Click" Padding="20,8" Appearance="Primary"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
