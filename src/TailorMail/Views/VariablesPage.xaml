<UserControl x:Class="TailorMail.Views.VariablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Click="OnAddVariableClick" Margin="0,0,4,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="添加变量"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="OnRenameVariable" Margin="0,0,4,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Rename24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="重命名"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="OnDeleteVariable" Margin="0,0,4,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="删除变量"/>
                        </StackPanel>
                    </ui:Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding ExportVariablesCommand}" Margin="0,0,4,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="导出"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Command="{Binding ImportVariablesCommand}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="导入"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardStyle}" Margin="0">
                <DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                          FontSize="13" FontFamily="{StaticResource UIFontFamily}"
                          CellEditEnding="OnCellEditEnding"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          BorderThickness="0" Background="Transparent"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          RowStyle="{StaticResource HoverRowStyle}"/>
            </Border>
            <Border x:Name="VarEmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Tag24" Style="{StaticResource EmptyStateIconStyle}"/>
                    <TextBlock Text="暂无变量" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="变量用于为每个收件人定制不同的邮件内容" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="例如：「公司」「职位」「入职日期」等" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="点击下方按钮创建新变量" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <ui:Button Click="OnAddVariableClick" Padding="16,6" HorizontalAlignment="Center" Appearance="Primary">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="添加变量"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
            <Border x:Name="VarErrorState" Style="{StaticResource ErrorStateStyle}" Visibility="Collapsed">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ErrorCircle24" Style="{StaticResource EmptyStateIconStyle}" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="数据加载失败" Style="{StaticResource EmptyStateTextStyle}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="数据加载失败，请重新打开软件后重试" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <ui:InfoBar x:Name="VarUsageHint"
                        Title="" Message="" IsOpen="False" IsClosable="False"
                        Severity="Informational" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>