<UserControl x:Class="TailorMail.Views.RecipientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="200" MinWidth="160" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：分组管理 -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 + 添加分组按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="分组" FontWeight="Black" FontSize="14" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Command="{Binding AddGroupCommand}" Padding="6,4" HorizontalAlignment="Right"
                            ToolTip="添加分组">
                        <ui:SymbolIcon Symbol="Add24" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- 分组列表 -->
                <ListBox Grid.Row="1" x:Name="GroupListBox" ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name"
                         SelectionMode="Single" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="重命名" Click="OnRenameGroup"/>
                            <MenuItem Header="删除" Click="OnDeleteGroup"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 删除分组按钮 -->
                <Button Grid.Row="2" Click="OnDeleteGroup" Padding="12,6" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="删除分组"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"
                      Cursor="SizeWE"/>

        <!-- 右侧：收件对象管理 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 收件对象操作按钮 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左对齐的按钮 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="OnAddRecipientClick" Margin="0,0,4,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="添加"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeleteSelected" Click="BtnDeleteSelected_Click" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="删除已选"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧的搜索和导入导出按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox x:Name="SearchBox" PlaceholderText="搜索收件人..." MinWidth="140" MaxWidth="260" Margin="0,0,4,0"
                                    TextChanged="OnSearchTextChanged" Icon="{ui:SymbolIcon Search24}"/>
                        <Button Command="{Binding ImportFromOtherGroupCommand}" Margin="0,0,4,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="跨组复制"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportToExcelCommand}" Margin="0,0,4,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="导出"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFromExcelCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="导入"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 收件对象列表 -->
            <Grid Grid.Row="1">
                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <DataGrid x:Name="RecipientsGrid" ItemsSource="{Binding CurrentRecipients}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" CellEditEnding="OnCellEditEnding"
                          PreviewKeyDown="OnGridPreviewKeyDown"
                          RowEditEnding="OnRowEditEnding"
                          LostFocus="OnGridLostFocus"
                          MouseLeftButtonUp="OnGridMouseClick"
                          MouseDoubleClick="OnGridDoubleClick"
                          AllowDrop="True"
                          PreviewMouseMove="OnGridPreviewMouseMove"
                          PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                          DragOver="OnGridDragOver"
                          Drop="OnGridDrop"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                          FontSize="13" FontFamily="{StaticResource UIFontFamily}"
                          BorderThickness="0" Background="Transparent"
                          HeadersVisibility="Column"
                          Sorting="OnGridSorting"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          RowHeight="NaN"
                          IsSynchronizedWithCurrentItem="False"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          RowStyle="{StaticResource HoverRowStyle}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="上移" Click="OnMoveUp"/>
                            <MenuItem Header="下移" Click="OnMoveDown"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="OnDeleteRow"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="58" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.Header>
                                <Grid HorizontalAlignment="Stretch" Margin="-3,0,-3,0">
                                    <CheckBox x:Name="HeaderCheckBox" Click="OnHeaderCheckBoxClick"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="全选/取消全选"/>
                                </Grid>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Stretch">
                                        <CheckBox IsChecked="{Binding IsSelected,UpdateSourceTrigger=PropertyChanged}"
                                                  Click="OnCheckClick" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name,UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="80" MaxWidth="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="AcceptsReturn" Value="False"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="简称" Binding="{Binding ShortName,UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="60" MaxWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="收件人" Binding="{Binding ToEmails,UpdateSourceTrigger=LostFocus}" Width="*" MinWidth="100" MaxWidth="350">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="抄送" Binding="{Binding CcEmails,UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="40" MaxWidth="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="密送" Binding="{Binding BccEmails,UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="40" MaxWidth="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark,UpdateSourceTrigger=LostFocus}" Width="Auto" MinWidth="40" MaxWidth="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridWrappingCellStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="40" IsReadOnly="True" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OnDeleteRowClick" Tag="{Binding}"
                                            Style="{StaticResource DeleteRowButtonStyle}"
                                            ToolTip="删除此行" Margin="2,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
                <Border x:Name="EmptyState" Style="{StaticResource EmptyStateStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="People24" Style="{StaticResource EmptyStateIconStyle}"/>
                        <TextBlock Text="暂无收件对象" Style="{StaticResource EmptyStateTextStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="点击下方按钮或双击表格区域添加" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Button Click="OnAddRecipientClick" Padding="16,6" HorizontalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,4,0" Foreground="White"/>
                                <TextBlock Text="添加收件人"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorState" Style="{StaticResource ErrorStateStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ErrorCircle24" Style="{StaticResource EmptyStateIconStyle}" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="数据加载失败" Style="{StaticResource EmptyStateTextStyle}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="数据加载失败，请重新打开软件后重试" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>