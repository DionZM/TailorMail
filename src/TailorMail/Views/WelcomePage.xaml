<UserControl x:Class="TailorMail.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Border Style="{StaticResource CardStyle}" Padding="32,40" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <StackPanel>
                <ui:SymbolIcon Symbol="Mail24" FontSize="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="欢迎使用千函 TailorMail" FontSize="{StaticResource FontSizeMD}" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"
                           FontFamily="{StaticResource DisplayFontFamily}"/>
                <TextBlock Text="高效、专业的邮件群发工具" FontSize="{StaticResource FontSizeSM}"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"
                           FontFamily="{StaticResource UIFontFamily}"/>

                <Border Background="{StaticResource AccentLightBrush}" CornerRadius="{StaticResource CornerRadiusMD}"
                        Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📋 操作流程" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextSecondaryBrush}">
                            1. 选择收件人 → 2. 配置变量 → 3. 撰写邮件 → 4. 匹配附件 → 5. 预览效果 → 6. 批量发送
                            <LineBreak/><LineBreak/>
                            顶部步骤条可随时切换，支持 Ctrl+N 新建、Ctrl+S 保存
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button x:Name="BtnStart" Content="开始使用" Click="BtnStart_Click" Padding="24,8" Appearance="Primary" MinWidth="120"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>