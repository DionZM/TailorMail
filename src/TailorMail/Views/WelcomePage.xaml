<UserControl x:Class="TailorMail.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Border Style="{StaticResource CardStyle}" Padding="40,48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
            <StackPanel>
                <!-- Logo + 标题 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border Background="{StaticResource AccentLightBrush}" CornerRadius="16" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image Source="pack://application:,,,/logo_256.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="千函" FontSize="{StaticResource FontSizeLG}" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource DisplayFontFamily}"/>
                    <TextBlock Text="TailorMail" FontSize="{StaticResource FontSizeBase}" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Text="高效、专业的个性化邮件群发工具" FontSize="{StaticResource FontSizeSM}"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,28"/>

                <!-- 操作流程 -->
                <Border Background="{StaticResource AccentLightBrush}" CornerRadius="{StaticResource CornerRadiusMD}"
                        Padding="20,16" Margin="0,0,0,20">
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">操作流程</Run>
                        <LineBreak/>
                        <Run>选择收件人 → 配置变量 → 撰写邮件 → 匹配附件 → 预览效果 → 批量发送</Run>
                        <LineBreak/>
                        <Run Foreground="{StaticResource TextTertiaryBrush}">顶部步骤条随时切换 · Ctrl+N 新建 · Ctrl+S 保存</Run>
                    </TextBlock>
                </Border>

                <!-- 开始按钮 -->
                <ui:Button x:Name="BtnStart" Content="开始使用" Click="BtnStart_Click"
                           Padding="32,10" Appearance="Primary" MinWidth="160" FontSize="{StaticResource FontSizeBase}"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- 底部信息：项目地址 + 授权 -->
                <StackPanel Margin="0,0,0,8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" HorizontalAlignment="Center">
                        <TextBlock Text="项目地址" FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="{StaticResource FontSizeSM}" VerticalAlignment="Center">
                            <Hyperlink NavigateUri="https://github.com/DionZM/TailorMail"
                                       Foreground="{StaticResource AccentBrush}" TextDecorations="None"
                                       RequestNavigate="OnLinkClick">
                                github.com/DionZM/TailorMail
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="开源授权" FontSize="{StaticResource FontSizeSM}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Apache License 2.0" FontSize="{StaticResource FontSizeSM}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- 版本号 -->
                <TextBlock x:Name="TxtVersion" Text="" FontSize="{StaticResource FontSizeXS}"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
