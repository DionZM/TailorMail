<UserControl x:Class="TailorMail.Views.SendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,12">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="发送进度" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ProgressBar Grid.Column="1" x:Name="ProgressBar" Height="8" Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Grid.Column="2" x:Name="TxtPercent" Text="0%" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}"
                               Style="{StaticResource TabularNumberStyle}"/>
                    <TextBlock Grid.Column="3" x:Name="TxtProgress" Text="0/0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{StaticResource TextPrimaryBrush}"
                               Style="{StaticResource TabularNumberStyle}"/>
                </Grid>
                <TextBlock x:Name="TxtCurrentRecipient" Text=""
                           Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardStyle}" Margin="0" Padding="12,8,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 筛选栏：紧贴 DataGrid 上方 -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="8,0,0,4" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="筛选：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" FontSize="{StaticResource FontSizeSM}"/>
                                <RadioButton x:Name="FilterAll" Content="全部" IsChecked="True" GroupName="SendFilter" Click="OnFilterClicked" Margin="0,0,8,0"
                                             FontSize="{StaticResource FontSizeSM}" FontFamily="{StaticResource UIFontFamily}" Padding="10,4"/>
                                <RadioButton x:Name="FilterSuccess" Content="成功" GroupName="SendFilter" Click="OnFilterClicked" Margin="0,0,8,0"
                                             FontSize="{StaticResource FontSizeSM}" FontFamily="{StaticResource UIFontFamily}" Padding="10,4"/>
                                <RadioButton x:Name="FilterFailed" Content="失败" GroupName="SendFilter" Click="OnFilterClicked" Margin="0,0,8,0"
                                             FontSize="{StaticResource FontSizeSM}" FontFamily="{StaticResource UIFontFamily}" Padding="10,4"/>
                                <RadioButton x:Name="FilterPending" Content="等待" GroupName="SendFilter" Click="OnFilterClicked"
                                             FontSize="{StaticResource FontSizeSM}" FontFamily="{StaticResource UIFontFamily}" Padding="10,4"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TxtEta" Text="" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnRetryAll" Content="全部重试" Click="OnRetryAll" Margin="0,0,4,0" Padding="8,4" FontSize="{StaticResource FontSizeXS}"
                                        Visibility="Collapsed"/>
                                <Button x:Name="BtnExport" Content="导出结果" Click="OnExportResults" Margin="0,0,0,0" Padding="8,4" FontSize="{StaticResource FontSizeXS}"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="DataGridResults" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="{StaticResource SurfaceBrush}"
                          FontSize="{StaticResource FontSizeSM}" FontFamily="{StaticResource UIFontFamily}"
                          BorderThickness="0" Background="Transparent"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          RowStyle="{StaticResource HoverRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="收件对象" Binding="{Binding RecipientName}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="状态" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Clock24"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Symbol" Value="DismissCircle24"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Sending">
                                                                <Setter Property="Symbol" Value="ArrowExportUp24"/>
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Sending">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="发送时间" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SendTime,StringFormat='{}{0:HH:mm:ss}'}"
                                                   ToolTip="{Binding SendTime,StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="重试" Click="OnRetryOne" Tag="{Binding RecipientId}" Padding="8,4" FontSize="{StaticResource FontSizeXS}"
                                                Visibility="{Binding Status,Converter={StaticResource FailedToVisibilityConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
